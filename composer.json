{
    "name": "laraxot/module_ai_fila5",
    "description": "AI integration module for the Laraxot ecosystem",
    "homepage": "https://github.com/laraxot/module_ai_fila5",
    "license": "MIT",
    "authors": [
        {
            "name": "marco sottana",
            "email": "marco.sottana@gmail.com",
            "role": "Developer"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Modules\\AI\\Providers\\AIServiceProvider",
                "Modules\\AI\\Providers\\Filament\\AdminPanelProvider"
            ],
            "aliases": {}
        }
    },
    "autoload": {
        "psr-4": {
            "Modules\\AI\\": "app/",
            "Modules\\AI\\Database\\Factories\\": "database/factories/",
            "Modules\\AI\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Modules\\AI\\Tests\\": "tests/"
        }
    },
    "require": {
        "openai-php/laravel": "^0.20",
        "php": "^8.3"
    },
    "require-dev": {
        "codewithkyrian/transformers": "^0.5.2"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Xot"
        },
        {
            "type": "path",
            "url": "../Tenant"
        },
        {
            "type": "path",
            "url": "../UI"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "codewithkyrian/transformers-libsloader": true
        }
    }
}
