# Laraxot AI module ignore rules

# Dependencies and package manager artifacts
vendor/
node_modules/
package-lock.json
npm-debug.log
yarn-error.log

# Python environments and generated files
venv/
bin/venv/

# Build output and caches
build/
cache/
docs/cache/
docs/phpstan/
*.cache
.php-cs-fixer.cache
.phpunit.result.cache

# Temporary files and logs
*.lock
*.phar
*.log
*.tmp
*.old
*.old1
*.backup
*.backup.*
error_log

# Laravel runtime and local environment
bootstrap/compiled.php
app/storage/
public/storage
public/hot
public_html/storage
public_html/hot
storage/*.key
.env
Homestead.yaml
Homestead.json
/.vagrant

# Git and merge artifacts
.git-rewrite/
.git-blame-ignore-revs
*~HEAD
*~BASE
*~LOCAL
*~REMOTE
*~head
*.orig
*.rej

# Documentation and legacy material
_docs/
lang/lang/
docs/archive/
docs/legacy/

# Editor and assistant tooling
.vscode/
.windsurf/
.devcontainer/
.claude-audit/
agentdb.rvf

# Generated test artifacts
/tests/AuditCoverage/

# Agent tooling and local audit output

# Module-local quality tool configuration
.rector.php
.phpinsights.php

# Root agent tooling and PHP quality configuration
/.agents/
/.codex/
/.cursor/
/.opencode/
/.qwen/
/rector.php
/phpinsights.php
/.php-cs-fixer.php
/.php-cs-fixer.dist.php

# Generated Claude audit coverage scaffold (never commit)
/audit-coverage/
