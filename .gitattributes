# Git attributes for this module. Git LFS is intentionally not used.
# Canon: bashscripts/ai/wiki/rules/no-git-lfs.md
* text=auto
*.css linguist-vendored
*.scss linguist-vendored
*.js linguist-vendored
CHANGELOG.md export-ignore

# Binary files remain regular Git blobs.
*.png binary !filter
*.jpg binary !filter
*.jpeg binary !filter
*.gif binary !filter
*.webp binary !filter
*.ico binary !filter
*.svg binary !filter
*.psd binary !filter
*.pdf binary !filter
*.zip binary !filter
*.woff binary !filter
*.woff2 binary !filter
*.ttf binary !filter
*.eot binary !filter
*.otf binary !filter
*.phar binary !filter
*.db binary !filter
*.sqlite binary !filter
